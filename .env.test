# .env.test — configuration for the Playwright E2E suite.
#
# COMMITTED ON PURPOSE. Every value here is either a local-only development
# constant or one of Supabase's well-known local demo keys, which are identical
# on every machine that runs `supabase start` and grant access to nothing but the
# throwaway Postgres in your own Docker. There are no real secrets in this file.
# `.gitignore` excludes `.env*`, so it carries an explicit `!.env.test` negation.
#
# NOTE: Next only auto-loads `.env.test` when NODE_ENV=test, and `next dev` runs
# as `development` — so this file is NOT picked up by the dev server on its own.
# `playwright.config.ts` reads it and forwards every key through
# `webServer.env`, which wins because `@next/env` never overwrites a key that is
# already present in `process.env`. That is what stops `.env.local` (which points
# at the hosted project) from being used during a test run.

# ─── Local Supabase (from `npx supabase status`) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── App config ─────────────────────────────────────────────────────────────
# Admin identity is BY EMAIL, not by a DB column or role — see src/lib/auth.ts
# and src/proxy.ts. This is what makes the seeded `admin` fixture an admin.
ADMIN_EMAIL=e2e-admin@forecast.test
NEXT_PUBLIC_APP_URL=http://localhost:3100

# ─── Test-only gates ────────────────────────────────────────────────────────
# Unlocks POST /api/test/login. The route 404s when this is unset or when
# NODE_ENV=production, so it cannot exist in a real deployment.
E2E_TEST_SECRET=e2e-local-only-secret
# Bearer token for the two /api/cron/* routes.
CRON_SECRET=e2e-local-cron-secret
